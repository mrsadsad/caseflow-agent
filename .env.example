# Default demo does not call a model. Configure for --mode live.
CASEFLOW_API_KEY=replace-locally
CASEFLOW_BASE_URL=https://api.deepseek.com
CASEFLOW_MODEL=deepseek-flash
# You can also select the existing parent .env with --env-file ../.env.
# DEEPSEEK_API_KEY is supported as a fallback. No credentials enter the browser.
